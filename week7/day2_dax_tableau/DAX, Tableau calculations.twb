              <table-calc ordering-field='[federated.0zvxi0r0yvs51q1go9jrt03hpb5w].[none:masterCategory:nk]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_3451503591489556]' derivation='User' name='[usr:Calculation_3451503591489556:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
            </column-instance>
          </datasource-dependencies>
          <computed-sort column='[federated.0zvxi0r0yvs51q1go9jrt03hpb5w].[none:masterCategory:nk]' direction='DESC' using='[federated.0zvxi0r0yvs51q1go9jrt03hpb5w].[cnt:id:qk]' />
          <filter class='quantitative' column='[federated.0zvxi0r0yvs51q1go9jrt03hpb5w].[usr:Calculation_3451503591075857:qk:2]' included-values='in-range'>
            <min>1</min>
            <max>7</max>
