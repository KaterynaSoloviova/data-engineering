      <aliases enabled='yes' />
      <column caption='Missing Usage' datatype='integer' name='[Calculation_3451503499591680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([usage]) OR UPPER(TRIM([usage])) = &quot;NA&quot; &#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Missing baseColor' datatype='integer' name='[Calculation_3451503502544897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull ([baseColour]) or UPPER(trim([baseColour])) = &quot;NA&quot; then 1 else 0 end' />
      </column>
      <column caption='Missing Year' datatype='integer' name='[Calculation_3451503504203778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([year])&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Total Products' datatype='integer' name='[Calculation_3451503506518019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id])' />
      </column>
      <column caption='Unique Products' datatype='integer' name='[Calculation_3451503571214340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id])' />
      </column>
      <column caption='Unique Categories' datatype='integer' name='[Calculation_3451503571742725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([masterCategory])' />
      </column>
      <column caption='Gender Contribution %' datatype='real' default-format='p0.00%' name='[Calculation_3451503573508103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id]) /&#10;MIN({ FIXED : COUNT([id]) })' />
      </column>
      <column caption='Gender Segments' datatype='string' name='[Calculation_3451503580098568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [gender] = &quot;Men&quot; OR [gender] = &quot;Women&quot; THEN &quot;Adult&quot;&#10;&#10;ELSEIF [gender] = &quot;Boys&quot; OR [gender] = &quot;Girls&quot; THEN &quot;Kids&quot;&#10;&#10;ELSEIF [gender] = &quot;Unisex&quot; THEN &quot;Unisex&quot;&#10;&#10;ELSE &quot;Other&quot;&#10;&#10;END' />
      </column>
      <column caption='Casual Product %' datatype='real' name='[Calculation_3451503581347849]' role='measure' type='quantitative'>
